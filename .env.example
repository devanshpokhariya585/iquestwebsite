# ---- MongoDB ----
# The connection string. Use the one from MongoDB Compass.
# Local MongoDB (Compass default):
MONGODB_URI=mongodb://127.0.0.1:27017/iquest
# MongoDB Atlas example (uncomment and use instead):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/iquest?retryWrites=true&w=majority

# ---- API server ----
PORT=5000

# ---- Optional ----
# Protects GET /api/subscribers. Leave unset to keep that endpoint locked.
# Send it as the header:  x-admin-token: <value>
# ADMIN_TOKEN=change-me

# Only needed if the frontend is served from a DIFFERENT origin than the API.
# Leave unset for the normal dev proxy / single-server production setup.
# VITE_API_URL=http://localhost:5000
